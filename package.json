{
  "name": "web-media-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "build:github": "tsc -b && vp build --mode github-pages",
