    "preview": "vp preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -u \"github-actions-bot <github-actions@github.com>\" --repo https://x-access-token:${GITHUB_TOKEN}@github.com/brandon-james-dev/web-media-manager.git"
  },
