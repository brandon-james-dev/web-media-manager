<?xml version="1.0" encoding="UTF-8"?>
<Theme xmlns="urn:wmm:theme:1" spec="1.0">
  <Palettes>
    <Palette scheme="light">
      <Set slot="background" value="#fef7ff" />
      <Set slot="foreground" value="#1d1b20" />
      <Set slot="accent" value="#e8def8" />
      <Set slot="accentForeground" value="#1d192b" />
      <Set slot="primary" value="#6750a4" />
      <Set slot="primaryForeground" value="#ffffff" />
      <Set slot="border" value="#cac4d0" />
      <Set slot="card" value="#f3edf7" />
      <Set slot="cardForeground" value="#1d1b20" />
      <Set slot="popover" value="#ece6f0" />
      <Set slot="popoverForeground" value="#1d1b20" />
      <Set slot="secondary" value="#ece6f0" />
      <Set slot="secondaryForeground" value="#1d1b20" />
      <Set slot="muted" value="#e6e0e9" />
      <Set slot="mutedForeground" value="#49454f" />
      <Set slot="input" value="#79747e" />
      <Set slot="ring" value="#6750a4" />
      <Set slot="selection" value="#e8def8" />
      <Set slot="selectionForeground" value="#1d192b" />
      <Set slot="progressTrack" value="#e8def8" />
      <Set slot="progressFill" value="#6750a4" />
    </Palette>
    <Palette scheme="dark">
      <Set slot="background" value="#141218" />
      <Set slot="foreground" value="#e6e0e9" />
      <Set slot="accent" value="#4a4458" />
      <Set slot="accentForeground" value="#e8def8" />
      <Set slot="primary" value="#d0bcff" />
      <Set slot="primaryForeground" value="#381e72" />
      <Set slot="border" value="#49454f" />
      <Set slot="card" value="#211f26" />
      <Set slot="cardForeground" value="#e6e0e9" />
      <Set slot="popover" value="#2b2930" />
      <Set slot="popoverForeground" value="#e6e0e9" />
      <Set slot="secondary" value="#2b2930" />
      <Set slot="secondaryForeground" value="#e6e0e9" />
      <Set slot="muted" value="#36343b" />
      <Set slot="mutedForeground" value="#cac4d0" />
      <Set slot="input" value="#938f99" />
      <Set slot="ring" value="#d0bcff" />
      <Set slot="selection" value="#4a4458" />
      <Set slot="selectionForeground" value="#e8def8" />
      <Set slot="progressTrack" value="#4a4458" />
      <Set slot="progressFill" value="#d0bcff" />
    </Palette>
  </Palettes>

  <Metrics>
    <Length id="gap-sm" value="4" />
    <Length id="gap-md" value="8" />
    <Length id="gap-lg" value="16" />
    <Length id="edge" value="16" />
    <Length id="card-radius" value="12" />
    <Length id="sheet-radius" value="28" />
    <Length id="app-bar-height" value="64" />
    <Length id="nav-bar-height" value="80" />
  </Metrics>

  <Fonts>
    <FontFamily id="ui" fallback="systemUi" />
  </Fonts>

  <TextStyles>
    <TextStyle id="body" font="@font/ui" size="16" color="@slot/foreground" />
    <TextStyle id="label" basedOn="@text/body" size="14" weight="500" />
    <TextStyle id="caption" basedOn="@text/body" size="14" color="@slot/mutedForeground" />
    <TextStyle id="on-primary" basedOn="@text/label" color="@slot/primaryForeground" />
    <TextStyle id="section" basedOn="@text/label" color="@slot/primary" />
    <TextStyle id="title-large" basedOn="@text/body" size="22" weight="400" letterSpacing="0" />
    <TextStyle id="headline" basedOn="@text/body" size="24" weight="400" letterSpacing="0" />
    <TextStyle id="np-title" basedOn="@text/body" size="24" weight="500" letterSpacing="0" align="center" />
    <TextStyle id="np-detail" basedOn="@text/body" color="@slot/mutedForeground" align="center" />
    <TextStyle id="playing" basedOn="@text/body" weight="500" color="@slot/primary" />
  </TextStyles>

  <Shadows>
    <Shadow id="elevation-1" x="0" y="1" blur="2" spread="0" color="#0000004d">
      <Layer x="0" y="1" blur="3" spread="1" color="#00000026" />
    </Shadow>
    <Shadow id="elevation-3" x="0" y="1" blur="3" spread="0" color="#0000004d">
      <Layer x="0" y="4" blur="8" spread="3" color="#00000026" />
    </Shadow>
    <Shadow id="focus" x="0" y="0" blur="0" spread="3" color="#6750a480" />
  </Shadows>

  <ButtonStyles>
    <ButtonStyle id="icon" background="transparent" foreground="@slot/mutedForeground"
                 cornerRadius="20" padding="8" minWidth="40" minHeight="40" iconSize="24"
                 textStyle="@text/label">
      <State name="hover" background="@slot/muted" />
      <State name="pressed" background="@slot/accent" />
      <State name="active" foreground="@slot/primary" />
      <State name="focused" shadow="@shadow/focus" />
      <State name="disabled" opacity="0.38" />
    </ButtonStyle>

    <ButtonStyle id="icon-lg" basedOn="@button/icon" foreground="@slot/foreground" cornerRadius="24"
                 minWidth="48" minHeight="48" iconSize="28" />

    <ButtonStyle id="nav-item" background="transparent" foreground="@slot/mutedForeground"
                 cornerRadius="16" padding="4 20" minWidth="64" minHeight="32" iconSize="24"
                 textStyle="@text/label">
      <State name="hover" background="@slot/muted" />
      <State name="pressed" background="@slot/accent" />
      <State name="selected" background="@slot/accent" foreground="@slot/accentForeground" />
      <State name="focused" shadow="@shadow/focus" />
    </ButtonStyle>

    <ButtonStyle id="tab" background="transparent" foreground="@slot/mutedForeground"
                 cornerRadius="8" padding="6 16" minWidth="48" minHeight="40" iconSize="20"
                 textStyle="@text/label">
      <State name="hover" background="@slot/muted" />
      <State name="pressed" background="@slot/accent" />
      <State name="selected" background="@slot/accent" foreground="@slot/accentForeground" />
      <State name="focused" shadow="@shadow/focus" />
    </ButtonStyle>

    <ButtonStyle id="filled" background="@slot/primary" foreground="@slot/primaryForeground"
                 cornerRadius="20" padding="10 24" minHeight="40" iconSize="18"
                 textStyle="@text/on-primary">
      <State name="hover" shadow="@shadow/elevation-1" />
      <State name="pressed" opacity="0.9" />
      <State name="focused" shadow="@shadow/focus" />
      <State name="disabled" opacity="0.38" />
    </ButtonStyle>

    <ButtonStyle id="fab" background="@slot/accent" foreground="@slot/accentForeground"
                 cornerRadius="16" padding="16" minWidth="56" minHeight="56" iconSize="24"
                 shadow="@shadow/elevation-3">
      <State name="hover" shadow="@shadow/elevation-1" />
      <State name="pressed" opacity="0.9" />
      <State name="focused" shadow="@shadow/focus" />
      <State name="disabled" opacity="0.38" />
    </ButtonStyle>

    <ButtonStyle id="np-play" background="@slot/primary" foreground="@slot/primaryForeground"
                 cornerRadius="28" padding="20" minWidth="96" minHeight="80" iconSize="36"
                 shadow="@shadow/elevation-1">
      <State name="hover" shadow="@shadow/elevation-3" />
      <State name="pressed" opacity="0.9" />
      <State name="focused" shadow="@shadow/focus" />
      <State name="disabled" opacity="0.38" />
    </ButtonStyle>

    <ButtonStyle id="mini-play" basedOn="@button/icon" foreground="@slot/foreground"
                 minWidth="48" minHeight="48" iconSize="28" />
  </ButtonStyles>

  <SliderStyles>
    <SliderStyle id="seek" thickness="4" cornerRadius="2" track="@slot/progressTrack"
                 fill="@slot/progressFill" buffer="@slot/muted" thumb="round" thumbSize="16">
      <State name="hover" thumbSize="20" />
      <State name="pressed" thickness="6" thumbSize="20" />
      <State name="disabled" opacity="0.38" />
    </SliderStyle>
    <SliderStyle id="edge" thickness="2" cornerRadius="0" track="@slot/progressTrack"
                 fill="@slot/progressFill" buffer="@slot/muted" thumb="none" />
  </SliderStyles>

  <PanelStyles>
    <PanelStyle id="plain" padding="0" />
    <PanelStyle id="app-bar" background="@slot/background" padding="8 4 8 16" />
    <PanelStyle id="nav-bar" background="@slot/card" padding="12 8 16 8" />
    <PanelStyle id="rail" background="@slot/background" padding="16 0" />
    <PanelStyle id="player-bar" background="@slot/card" cornerRadius="@length/sheet-radius"
                padding="12 24" />
    <PanelStyle id="mini-player" background="@slot/secondary" cornerRadius="@length/card-radius"
                padding="0" shadow="@shadow/elevation-1" clip="true" />
    <PanelStyle id="card" background="@slot/card" cornerRadius="@length/card-radius"
                padding="@length/gap-md" />
    <PanelStyle id="controls" background="@slot/card" cornerRadius="@length/sheet-radius"
                padding="16 16 12 16" />
  </PanelStyles>

  <Defaults button="@button/icon" panel="@panel/plain" text="@text/body" />
</Theme>
