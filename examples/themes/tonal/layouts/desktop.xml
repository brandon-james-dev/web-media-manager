<?xml version="1.0" encoding="UTF-8"?>
<Layout xmlns="urn:wmm:theme:1" spec="1.0" formFactor="desktop">
  <Shell>
    <Panel background="@slot/background">
      <DockPanel>
        <Panel dock="start" width="96" style="@panel/rail">
          <Stack gap="@length/gap-lg" align="center">
            <Button command="wmm.ui.navigate" commandParameter="now-playing" labelKey="navigation.nowPlaying" icon="@icon/nowPlaying" display="icon" style="@button/fab" />
            <Button command="wmm.ui.navigate" commandParameter="library" labelKey="navigation.library" icon="@icon/library" display="icon" style="@button/nav-item" />
            <Button command="wmm.ui.navigate" commandParameter="playlists" labelKey="navigation.playlists" icon="@icon/playlists" display="icon" style="@button/nav-item" />
            <Button command="wmm.ui.navigate" commandParameter="sync" labelKey="navigation.sync" icon="@icon/sync" display="icon" style="@button/nav-item" />
          </Stack>
        </Panel>

        <Panel dock="top" height="@length/app-bar-height" style="@panel/app-bar">
          <Stack orientation="horizontal" gap="@length/gap-md" align="center">
            <Text resourceKey="app.title" style="@text/title-large" grow="1" />
            <SearchBox scope="library" width="320" />
            <Button command="wmm.ui.openSettings" labelKey="settings.title" icon="@icon/settings" display="icon" style="@button/icon" />
          </Stack>
        </Panel>

        <Panel dock="bottom" height="88" style="@panel/player-bar" margin="0 16 16 0">
          <Grid columns="1* auto 1*" rows="1*" columnGap="@length/gap-lg">
            <Stack column="0" orientation="horizontal" gap="@length/gap-lg" align="center">
              <Artwork width="56" height="56" action="openNowPlaying" cornerRadius="8" />
              <TrackInfo grow="1" fields="title artist" titleText="@text/label" detailText="@text/caption" />
            </Stack>
            <Stack column="1" gap="@length/gap-sm" vAlign="center" width="420">
              <Stack orientation="horizontal" gap="@length/gap-sm" justify="center" align="center">
                <Button command="wmm.playback.toggleShuffle" labelKey="playback.shuffle" icon="@icon/shuffle" display="icon" style="@button/icon" />
                <Button command="wmm.playback.prev" labelKey="playback.previous" icon="@icon/prev" display="icon" style="@button/icon" />
                <Button command="wmm.playback.playpause" labelKey="playback.playPause" icon="@icon/playPause" display="icon" style="@button/fab" />
                <Button command="wmm.playback.next" labelKey="playback.next" icon="@icon/next" display="icon" style="@button/icon" />
                <Button command="wmm.playback.toggleRepeat" labelKey="playback.repeat" icon="@icon/repeat" display="icon" style="@button/icon" />
              </Stack>
              <Stack orientation="horizontal" gap="@length/gap-md" align="center">
                <PlaybackTime format="elapsed" text="@text/caption" />
                <SeekBar grow="1" slider="@slider/seek" />
                <PlaybackTime format="remaining" text="@text/caption" />
              </Stack>
            </Stack>
            <Stack column="2" orientation="horizontal" gap="@length/gap-sm" justify="end" align="center">
              <PlayQueue presentation="popover" artwork="true" clearButton="true" button="@button/icon" />
              <VolumeControl width="120" muteButton="true" slider="@slider/seek" button="@button/icon" />
            </Stack>
          </Grid>
        </Panel>

        <Panel dock="fill" style="@panel/plain" margin="0 16 16 0">
          <PageHost />
        </Panel>
      </DockPanel>
    </Panel>
  </Shell>

  <Page id="now-playing" role="nowPlaying" titleKey="navigation.nowPlaying">
    <Tabs strip="top" stripAlign="start" tabStyle="@button/tab">
      <Tab id="queue" titleKey="playback.queue" icon="@icon/queue">
        <Grid columns="1* 1*" rows="1*" columnGap="@length/gap-lg">
          <Stack column="0" gap="@length/gap-lg" align="center" vAlign="center">
            <Artwork width="320" height="320" cornerRadius="@length/sheet-radius" />
            <TrackInfo fields="title artist album" titleText="@text/np-title" detailText="@text/np-detail" />
          </Stack>
          <PlayQueue column="1" artwork="true" clearButton="true" upNext="true" panel="@panel/card" rowText="@text/body" />
        </Grid>
      </Tab>
      <Tab id="lyrics" titleKey="playback.lyrics" icon="@icon/lyrics">
        <Lyrics align="center" text="@text/headline" />
      </Tab>
      <Tab id="visualizer" titleKey="visualizer.title" icon="@icon/visualizer">
        <Visualizer selector="true" settingsButton="true" trackInfo="true" fallback="artwork" panel="@panel/card" />
      </Tab>
      <TabStripEnd>
        <Stack orientation="horizontal" gap="@length/gap-sm" idleHide="true">
          <Button command="wmm.ui.toggleDarkRoom" labelKey="playback.darkRoom" icon="@icon/darkRoom" display="icon" style="@button/icon" />
          <Button command="wmm.ui.toggleFullscreen" labelKey="common.fullScreen" icon="@icon/fullscreen" display="icon" style="@button/icon" />
        </Stack>
      </TabStripEnd>
    </Tabs>
  </Page>

  <Page id="library" role="library" titleKey="navigation.library" default="true">
    <Grid columns="240 1*" rows="auto 1*" columnGap="@length/gap-lg" rowGap="@length/gap-md">
      <LibraryBrowser row="0" column="0" rowSpan="2" views="artists albums genres songs"
                      initialView="artists" display="list" artwork="true"
                      panel="@panel/card" itemText="@text/body" headerText="@text/section" />
      <Stack row="0" column="1" orientation="horizontal" gap="@length/gap-md" align="center">
        <CollectionSummary grow="1" fields="title count duration" titleText="@text/headline" detailText="@text/caption" />
        <Button command="wmm.playback.playAll" labelKey="playback.play" icon="@icon/play" style="@button/filled" />
      </Stack>
      <TrackList row="1" column="1" columns="track title artist album duration offline"
                 showHeader="true" rowText="@text/body" headerText="@text/section" playingText="@text/playing" />
    </Grid>
  </Page>

  <Page id="playlists" role="playlists" titleKey="navigation.playlists">
    <Grid columns="260 1*" rows="1*" columnGap="@length/gap-lg">
      <Playlist column="0" artwork="true" panel="@panel/card" rowText="@text/body" />
      <TrackList column="1" columns="title artist album duration"
                 rowText="@text/body" headerText="@text/section" playingText="@text/playing" />
    </Grid>
  </Page>

  <Page id="sync" role="sync" titleKey="navigation.sync">
    <Grid columns="1* 1*" rows="auto 1*" columnGap="@length/gap-lg" rowGap="@length/gap-lg">
      <Stack row="0" column="0" columnSpan="2" orientation="horizontal" gap="@length/gap-md" align="center">
        <DevicePanel grow="1" storage="true" allowAdd="true" panel="@panel/card" titleText="@text/section" />
        <Button command="wmm.sync.start" labelKey="sync.start" icon="@icon/sync" style="@button/filled" />
      </Stack>
      <LibraryBrowser row="1" column="0" views="artists albums" display="list" artwork="true" panel="@panel/card" />
      <SyncQueue row="1" column="1" summary="true" panel="@panel/card" rowText="@text/body" />
    </Grid>
  </Page>
</Layout>
