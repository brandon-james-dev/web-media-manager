{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Edge: Debug Vite",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "vite:///*": "${workspaceFolder}/*"
      },
      "preLaunchTask": "vite-dev"
    }
  ]
}
